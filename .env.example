# Lampad AtlasBridge runs entirely on-device. No cloud AI keys required.
#
# The only environment variables are for the optional offline-SOS sync backend
# (see render.yaml). They are NOT needed to run the app locally or to use any
# of the on-device LLM / retrieval features.

# VITE_SOS_ENDPOINT: endpoint that receives queued SOS packets when connectivity
# returns. Read at build time. When left empty the app falls back to the hosted
# backend at https://lampad-backend.onrender.com/api/sos.
VITE_SOS_ENDPOINT=""

# VITE_BACKEND_WEBHOOK_BASE: reserved for future backend webhooks. Not read by
# the app today.
VITE_BACKEND_WEBHOOK_BASE=""

# --- Backend (server.js) only; not used by the frontend ------------------
# PORT: port the SOS backend listens on (Render sets this; defaults to 10000).
PORT=10000
# SOS_FORWARD_URL: optional upstream that received SOS packets are forwarded to.
# When unset, the backend just acknowledges receipt (2xx) so the client stops retrying.
SOS_FORWARD_URL=""
# SOS_FORWARD_TIMEOUT_MS: how long to wait on that upstream before giving up.
SOS_FORWARD_TIMEOUT_MS=10000
# CORS_ORIGIN: allowed origin for the SOS API. Defaults to "*".
CORS_ORIGIN=""
# Per-IP rate limit on POST /api/sos. Defaults: 30 requests per 60s window.
SOS_RATE_MAX=30
SOS_RATE_WINDOW_MS=60000
